          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"project_goal\": {\n      \"type\": \"string\"\n    },\n    \"phases\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"objective\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"actions\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\"High\", \"Medium\", \"Low\"]\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"objective\",\n          \"description\",\n          \"actions\",\n          \"priority\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"recommended_actions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"risks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"risk\": {\n            \"type\": \"string\"\n          },\n          \"mitigation\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\"risk\", \"mitigation\"],\n        \"additionalProperties\": false\n      }\n    },\n    \"estimated_duration\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"project_goal\",\n    \"phases\",\n    \"recommended_actions\",\n    \"risks\",\n    \"estimated_duration\"\n  ],\n  \"additionalProperties\": false\n}"
      },
